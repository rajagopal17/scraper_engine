# --- AI API (native wrapper; supports Anthropic or an OpenAI-compatible API) ---
# AI_PROVIDER: "anthropic" or "openai". If left blank, it's inferred from
# AI_BASE_URL (anything containing "openai.com" is treated as openai).
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
# Model names must match AI_PROVIDER, e.g. for openai: AI_SKILL_BUILD_MODEL=gpt-4o
AI_SKILL_BUILD_MODEL=claude-opus-4-20250514
AI_RUNTIME_MODEL=claude-haiku-4-20250514

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scraper_engine
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change_me

# --- Per-site login credentials ---
# Referenced by name (not value) from skills/<domain>.yaml, e.g.:
#   auth: { username_env: "SITE1_USER", password_env: "SITE1_PASS" }
# SITE1_USER=
# SITE1_PASS=

# --- Runtime defaults (all overridable) ---
HTTP_TIMEOUT_SECONDS=20
RATE_LIMIT_SECONDS_PER_DOMAIN=2.0
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=1.0
RETRY_BACKOFF_MAX_SECONDS=30
CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=5
MAX_AI_CALLS_PER_SITE_PER_RUN=10
MAX_AI_CALLS_PER_RUN=100
RESPECT_ROBOTS_TXT=true
